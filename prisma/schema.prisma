model tsmib_payments {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id           String                      @db.Uuid
  tenant_id                 String?                     @db.Uuid
  apartment_id              String?                     @db.Uuid
  payment_reference         String?                     @db.VarChar(100)
  amount                    Decimal                     @db.Decimal(14, 2)
  payment_date              DateTime                    @default(now()) @db.Timestamptz(6)
  payment_method_id         String                      @db.Uuid
  transaction_id            String?                     @db.VarChar(200)
  status                    String                      @default("SUCCESS") @db.VarChar(30)
  notes                     String?
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  tsmib_payment_allocations tsmib_payment_allocations[]
  tsmib_payment_receipts    tsmib_payment_receipts[]
  tsmib_apartments          tsmib_apartments?           @relation(fields: [apartment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tsmib_organizations       tsmib_organizations         @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tsmib_payment_method      tsmib_payment_method        @relation(fields: [payment_method_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tsmib_tenants             tsmib_tenants?              @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([apartment_id], map: "ix_payments_apartment")
  @@index([payment_date], map: "ix_payments_date")
  @@index([organization_id], map: "ix_payments_organization")
  @@index([tenant_id], map: "ix_payments_tenant")
  @@index([transaction_id], map: "ix_payments_transaction")
}

model tsmib_properties {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String              @db.Uuid
  name                String              @db.VarChar(200)
  code                String?             @db.VarChar(50)
  address_line1       String?             @db.VarChar(255)
  address_line2       String?             @db.VarChar(255)
  city                String?             @db.VarChar(100)
  state               String?             @db.VarChar(100)
  country             String?             @default("India") @db.VarChar(100)
