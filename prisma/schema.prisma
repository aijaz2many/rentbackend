model tsmib_payment_receipts {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String              @db.Uuid
  payment_id          String              @db.Uuid
  receipt_number      String              @db.VarChar(100)
  receipt_url         String?
