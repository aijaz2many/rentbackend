  last_used_at    DateTime?   @db.Timestamptz(6)
  tsmib_users     tsmib_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "ix_push_tokens_user")
}

