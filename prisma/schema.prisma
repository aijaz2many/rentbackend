  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  tsmib_audit_logs             tsmib_audit_logs[]
  tsmib_documents              tsmib_documents[]
  tsmib_expense_categories     tsmib_expense_categories[]
  tsmib_expenses               tsmib_expenses[]
  tsmib_leases                 tsmib_leases[]
  tsmib_maintenance_categories tsmib_maintenance_categories[]
  tsmib_maintenance_requests   tsmib_maintenance_requests[]
  tsmib_notifications          tsmib_notifications[]
  tsmib_payment_receipts       tsmib_payment_receipts[]
  tsmib_payments               tsmib_payments[]
  tsmib_properties             tsmib_properties[]
  tsmib_rent_charges           tsmib_rent_charges[]
  tsmib_tenants                tsmib_tenants[]
  tsmib_users                  tsmib_users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
